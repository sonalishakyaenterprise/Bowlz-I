# ─────────────────────────────────────────────────────────────
# Bowlz-I Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────

# Google Apps Script Web App URL
# Get this after deploying your script (see GOOGLE_SHEETS_SETUP.md)
NEXT_PUBLIC_GAS_ENDPOINT=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Secret key — must match the SECRET variable in google-apps-script.js
# Change this to anything you like, just keep it consistent in both places
NEXT_PUBLIC_GAS_SECRET=bowlzi2026

# ─────────────────────────────────────────────────────────────
# Phase 2 — Supabase (add when moving to Vercel, optional)
# ─────────────────────────────────────────────────────────────
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
